<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.agenda.conexion.HelloController">

    <top>
        <Label text="AGENDA DE PERSONAS"
               style="-fx-font-size: 22px; -fx-font-weight: bold;">
            <BorderPane.margin>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </BorderPane.margin>
        </Label>
    </top>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>

            <!-- DATOS DE LA PERSONA -->

            <Label text="Datos de la persona"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <HBox spacing="10">
                <Label text="Nombre:"/>
                <TextField fx:id="campoNombre"
                           promptText="Nombre"
                           prefWidth="250"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Dirección:"/>
                <TextField fx:id="campoDireccion"
                           promptText="Dirección"
                           prefWidth="250"/>
            </HBox>

            <HBox spacing="10">
                <Button text="Agregar"
                        onAction="#agregarPersona"/>

                <Button text="Modificar"
                        onAction="#modificarPersona"/>

                <Button text="Eliminar"
                        onAction="#eliminarPersona"/>

            </HBox>

            <Label text="Personas registradas"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <TableView fx:id="tablaPersonas"
                       prefHeight="250">

                <columns>

                    <TableColumn fx:id="columnaId"
                                 text="ID"
                                 prefWidth="60"/>

                    <TableColumn fx:id="columnaNombre"
                                 text="Nombre"
                                 prefWidth="200"/>

                    <TableColumn fx:id="columnaDireccion"
                                 text="Dirección"
                                 prefWidth="300"/>

                </columns>

            </TableView>

            <!-- TELEFONOS -->

            <Label text="Teléfonos de la persona seleccionada"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <HBox spacing="10">

                <Label text="Teléfono:"/>

                <TextField fx:id="campoTelefono"
                           promptText="Número de teléfono"
                           prefWidth="200"/>

                <Button text="Agregar teléfono"
                        onAction="#agregarTelefono"/>

                <Button text="Modificar teléfono"
                        onAction="#modificarTelefono"/>

                <Button text="Eliminar teléfono"
                        onAction="#eliminarTelefono"/>

            </HBox>

            <TableView fx:id="tablaTelefonos"
                       prefHeight="150">

                <columns>

                    <TableColumn fx:id="columnaTelefonoId"
                                 text="ID"
                                 prefWidth="60"/>

                    <TableColumn fx:id="columnaNumeroTelefono"
                                 text="Teléfono"
                                 prefWidth="250"/>

                </columns>

            </TableView>

        </VBox>
    </center>

</BorderPane>